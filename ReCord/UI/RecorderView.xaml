<UserControl x:Class="ReCord.UI.RecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:ReCord.UI"
             xmlns:services="clr-namespace:ReCord.Services"
             mc:Ignorable="d"
             d:DesignWidth="1480"
             d:DesignHeight="920"
             d:DataContext="{d:DesignInstance Type=ui:RecorderViewDesignData, IsDesignTimeCreatable=True}"
             Background="#1F2633"
             FontFamily="Microsoft YaHei"
             Foreground="{DynamicResource TextBrush}"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReCord;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="LogRow" Height="180" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="50" Height="50" Source="/ReCord;component/Assets/Logo.ico"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="ReCord" Style="{StaticResource BrandTitle}"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource StatusPill}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Padding="7,2">
                        <TextBlock Text="本地录制" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化">
                        <Path Data="M5 12H19" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="最大化/还原">
                        <Path x:Name="MaximizeIcon" Data="M5 5H19V19H5V5Z"
                              Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource DangerWindowButton}" Click="Close_Click" ToolTip="关闭">
                        <Path Data="M6 6L18 18M18 6L6 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="348" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="相机列表" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding CameraCountLabel}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BtnAdd}" Height="30"
                                VerticalAlignment="Center" Click="AddCamera_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Fill="White" Width="12" Height="12" Stretch="Uniform" />
                                <TextBlock Text="添加" FontSize="11" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,3,0">
                            <ItemsControl ItemsSource="{Binding Cameras}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CameraListItemControl
                                            Selected="CameraListItem_Selected"
                                            DeleteRequested="CameraListItem_DeleteRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyCameraPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCameras}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="58" Height="58" Background="#263448"
                                    BorderBrush="#3B4F68" BorderThickness="1"
                                    CornerRadius="29" HorizontalAlignment="Center">
                                <Viewbox Width="38" Height="38" Stretch="Uniform">
                                    <Canvas Width="40" Height="40">
                                        <Path Data="M5 15C5 13.34 6.34 12 8 12H24C25.66 12 27 13.34 27 15V24C27 25.66 25.66 27 24 27H8C6.34 27 5 25.66 5 24V15Z"
                                              Fill="Transparent" Stroke="#A3BCD9" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M14 12V7.5C14 6.67 14.67 6 15.5 6H18.5C19.33 6 20 6.67 20 7.5V12"
                                              Stroke="#A3BCD9" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M11.5 19.5A4.5 4.5 0 1 0 20.5 19.5A4.5 4.5 0 1 0 11.5 19.5Z"
                                              Fill="Transparent" Stroke="#D7E6F8" StrokeThickness="1.4" />
                                        <Path Data="M29 23A6 6 0 1 0 29 35A6 6 0 1 0 29 23Z"
                                              Fill="#263448" Stroke="#2F7DF6" StrokeThickness="1.6" />
                                        <Path Data="M25.5 29H32.5M29 25.5V32.5"
                                              Stroke="#5B9BFF" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="尚未添加相机" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="实时监看" Style="{StaticResource PanelTitle}" />
                        <Border Style="{StaticResource StatusPill}" Padding="7,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewModeLabel}" FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="全部录制" Style="{StaticResource BtnPrimary}" Height="30" Padding="12,4"
                                Click="StartAllRecording_Click" Margin="0,0,6,0"
                                IsEnabled="{Binding HasCameras}" />
                        <Button Content="全部停止" Style="{StaticResource BtnSmall}" Height="30" Padding="10,4"
                                Click="StopAllRecording_Click" IsEnabled="{Binding HasCameras}" />
                    </StackPanel>
                    </Grid>
                <Border Grid.Row="1" Background="{StaticResource CameraCardBgBrush}"
                        CornerRadius="{StaticResource RadiusCard}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="3">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Cameras}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.PreviewColumns,
                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CameraPreviewControl
                                        Frame="{Binding Frame}"
                                        Selected="CameraPreview_Selected" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="EmptyPreviewPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCameras}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="84" Height="84" CornerRadius="42" Background="#263448"
                                    BorderBrush="#3B4F68" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="54" Height="54" Stretch="Uniform">
                                    <Canvas Width="64" Height="64">
                                        <Path Data="M23 23V18C23 16.9 23.9 16 25 16H29C30.1 16 31 16.9 31 18V23"
                                              Stroke="#A7C2E5" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M9 27C9 24.79 10.79 23 13 23H41C43.21 23 45 24.79 45 27V43C45 45.21 43.21 47 41 47H13C10.79 47 9 45.21 9 43V27Z"
                                              Fill="Transparent" Stroke="#A7C2E5" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M19 35A8 8 0 1 0 35 35A8 8 0 1 0 19 35Z"
                                              Fill="Transparent" Stroke="#D7E6F8" StrokeThickness="1.4" />
                                        <Path Data="M23 31.5L32 35L23 38.5V31.5Z"
                                              Fill="#2F7DF6" StrokeLineJoin="Round" />
                                        <Path Data="M48 31C49.66 32.66 49.66 37.34 48 39"
                                              Stroke="#6F9EE0" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M52 27C54.76 29.76 54.76 40.24 52 43"
                                              Stroke="#A7C2E5" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="添加相机后开始监看" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="支持多路 RTSP 和本地视频输入" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,3,0">
                    <StackPanel>
                        <Grid Height="44" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="录制控制" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="SelectedCameraStateText" Text="未选择相机" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="EditCameraButton" Grid.Column="1" Content="编辑源" Style="{StaticResource QuietButton}"
                                    Height="30" Padding="9,4" Click="EditCamera_Click" IsEnabled="False" />
                        </Grid>
                        <Border Style="{StaticResource CardSurface}" Padding="12,10" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SelectedOnlineDot" Width="8" Height="8" Fill="#67737D"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="SelectedCameraNameText" Text="未选择相机" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelectedSourceText" Text="--" Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="输出位置" Style="{StaticResource LabelParam}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryBox" FontSize="11" Height="36" />
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource BtnSmall}" Width="54" Height="36"
                                    Padding="7,4" Margin="6,0,0,0" Click="BrowseOutput_Click" />
                        </Grid>
                        <TextBlock Text="文件名前缀" Style="{StaticResource LabelParam}" />
                        <TextBox x:Name="PrefixBox" Height="36" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="帧率" Style="{StaticResource ControlLabel}" />
                                <TextBox x:Name="FpsBox" Height="36" Tag="25" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="码率 (Kbps)" Style="{StaticResource ControlLabel}" />
                                <TextBox x:Name="BitrateBox" Height="36" Tag="4000" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AutoRecordCheck" Content="程序启动后自动录制" FontSize="11" Margin="0,14,0,0" />
                        <Button Content="保存录制设置" Style="{StaticResource BtnSmall}" HorizontalAlignment="Stretch"
                                Height="34" Margin="0,12,0,0" Click="SaveSettings_Click" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,16" />
                        <TextBlock Text="当前录制" Style="{StaticResource SubTitleStyle}" />
                        <TextBlock x:Name="RecordingDurationText" Text="00:00:00" Style="{StaticResource MetricText}"
                                   Margin="0,7,0,0" />
                        <TextBlock x:Name="RecordingFilePathText" Text="准备就绪" FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Button x:Name="SelectedRecordButton" Style="{StaticResource RecordButton}" Height="42"
                                Click="ToggleSelectedRecording_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SelectedRecordIcon" Width="10" Height="10" Fill="White"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedRecordButtonText" Text="开始录制" Foreground="White"
                                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="本机编码 · H.264 / MP4" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" Cursor="SizeNS" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="3" Margin="12,8,12,12" Background="{StaticResource LogPanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource HeaderBarBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="运行日志" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="StatusBarText" Text="就绪" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LogCountLabel}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="清空" Style="{StaticResource BtnSmall}" Height="28" Padding="8,3"
                                    Click="ClearLog_Click" Margin="0,0,6,0" />
                            <Button Content="收起" x:Name="LogToggleButton" Style="{StaticResource BtnSmall}"
                                    Height="28" Padding="8,3" Click="ToggleLog_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}"
                                                             Value="{x:Static services:AppLogLevel.Warning}">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}"
                                                             Value="{x:Static services:AppLogLevel.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}"
                                                             Value="{x:Static services:AppLogLevel.Record}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <ui:AddCameraOverlay x:Name="AddCameraPanel" Grid.RowSpan="4" Visibility="Collapsed" />
        <ui:FolderPickerOverlay x:Name="FolderPickerPanel" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</UserControl>
