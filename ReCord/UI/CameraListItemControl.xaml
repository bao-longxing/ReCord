<UserControl x:Class="ReCord.UI.CameraListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:ReCord.UI"
             mc:Ignorable="d"
             d:DesignWidth="220"
             d:DesignHeight="64"
             d:DataContext="{d:DesignInstance Type=ui:CameraViewItem, IsDesignTimeCreatable=True}"
             MouseLeftButtonDown="Root_MouseLeftButtonDown"
             Cursor="Hand" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReCord;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="RootBorder" CornerRadius="{StaticResource RadiusCard}"
            Padding="12,9" Margin="0,0,0,8" MinHeight="58">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="OnlineDot" Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource RecordingBadge}" Margin="0,0,4,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource RedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="REC" FontFamily="Segoe UI"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#FFFFD1D1"
                                   LineHeight="11" VerticalAlignment="Center" Margin="5,0,0,0" />
                    </Grid>
                </Border>
                <Button x:Name="DeleteButton" Style="{StaticResource BtnDelete}"
                        Padding="0" ToolTip="删除相机" Click="DeleteButton_Click">
                    <Path Data="M7 19V7H17V19H7ZM6 4V2H9L10 1H14L15 2H18V4H6ZM9 17H11V9H9V17ZM13 17H15V9H13V17Z"
                          Fill="{StaticResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
