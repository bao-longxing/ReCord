<UserControl x:Class="ReCord.UI.AddCameraOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="760"
             Background="#B8000000"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReCord;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="680" MaxHeight="700" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="24,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="添加相机" Style="{StaticResource DialogTitle}" />
                    <TextBlock Text="支持 ONVIF 自动发现、RTSP、HTTP 视频流和本地视频文件"
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DialogCloseButton}" Click="Cancel_Click"
                        Width="34" Height="34" ToolTip="关闭">
                    <Path Data="M6 6L18 18M18 6L6 18" Stroke="{StaticResource TextDimBrush}"
                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" Margin="0" MaxHeight="520"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="相机名称" Style="{StaticResource ControlLabel}" />
                <TextBox x:Name="NameBox" MaxLength="60" Height="38" Tag="例如：产线入口" />
                <TextBlock Text="视频源地址" Style="{StaticResource LabelParam}" />
                <TextBox x:Name="UrlBox" Height="76" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         Tag="例如：rtsp://user:pass@192.168.1.10/stream" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="选择本地视频" Style="{StaticResource BtnSmall}" Height="34" Click="PickFile_Click" />
                    <Button Grid.Column="1" Content="设备发现" Style="{StaticResource BtnPrimary}" Height="34"
                            Click="ToggleScan_Click" Margin="8,0,0,0" Padding="14,4" />
                    <TextBlock x:Name="HintText" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock x:Name="ValidationText" FontSize="12" Foreground="{StaticResource WarningBrush}"
                           Margin="0,12,0,0" Visibility="Collapsed" />
                <Border x:Name="ScanSection" Style="{StaticResource CardSurface}"
                        Background="{StaticResource CardDarkBrush}"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ONVIF 与局域网设备发现" Style="{StaticResource SubTitleStyle}" />
                                <TextBlock Text="自动解析 ONVIF 设备、品牌型号和 RTSP 码流，并补充端口扫描" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="关闭发现" Style="{StaticResource BtnSmall}"
                                    Click="ToggleScan_Click" Height="30" Padding="9,3" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ONVIF 用户名（可选）" Style="{StaticResource ControlLabel}" />
                                <TextBox x:Name="OnvifUsernameBox" Height="36" Tag="admin" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ONVIF 密码（可选）" Style="{StaticResource ControlLabel}" />
                                <PasswordBox x:Name="OnvifPasswordBox" Height="36" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ScanRangeBox" Height="36" Tag="例如：192.168.1.0/24" />
                            <Button x:Name="StartScanButton" Grid.Column="1" Content="开始发现"
                                    Style="{StaticResource BtnPrimary}" Width="100" Height="36" Margin="8,0,0,0"
                                    Click="StartScan_Click" />
                        </Grid>
                        <TextBlock x:Name="ScanStatusText" Grid.Row="3" Text="选择网段后开始发现"
                                   Style="{StaticResource CaptionText}" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,8" />
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="164" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#1C2735" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                                    Padding="3">
                                <Grid>
                                    <ListBox x:Name="ScanResultsList" SelectionMode="Extended"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="ScanResultsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="1,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Endpoint, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayUrl, Mode=OneWay}" FontSize="10"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="{StaticResource RadiusBadge}" Padding="7,3"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="9"
                                                           Foreground="{StaticResource AccentBlueBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ScanResultsList}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="M4 5H20V19H4V5ZM8 9H16V11H8V9ZM8 13H14V15H8V13Z"
                                              Fill="{StaticResource TextDimBrush}" Width="28" Height="28"
                                              Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock Text="尚未发现设备" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock x:Name="ScanSelectionText" Text="未发现设备" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Button x:Name="AddScannedButton" Content="添加选中相机" Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Right" Height="34" Padding="12,4"
                                        IsEnabled="False" Click="AddScanned_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,18,0,0" Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource BtnSmall}" Width="76" Height="34" Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button Content="保存相机" Style="{StaticResource BtnPrimary}" Width="100" Height="34" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
